// FirstSeat data model.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// `platform` was a Postgres enum and is now a validated lowercase slug. The set of
// booking platforms is open-ended editorial data that no code branches on, so an enum
// cost a migration per new platform and bought nothing. A CHECK constraint on both
// `platform` columns keeps the database enforcing the slug shape — Prisma cannot express
// CHECK constraints, so it lives only in the migration SQL. See src/lib/watches/platforms.ts.

enum Meal {
  BREAKFAST
  BRUNCH
  LUNCH
  DINNER
}

enum WatchStatus {
  ACTIVE
  PAUSED
  FULFILLED
  EXPIRED
  CANCELLED
}

enum DropAlertStatus {
  SCHEDULED
  SENT
  MISSED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  PUSH
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Application profile for a Supabase Auth user.
/// `id` intentionally has no default: it is set to the Supabase `auth.users.id`.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  timezone  String   @default("Europe/London")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  watches Watch[]

  @@map("users")
}

model Restaurant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  city      String
  /// App-relative path under `public/`, e.g. `/restaurants/minetta-tavern.jpg`.
  /// Null means the catalog card shows the striped placeholder.
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  releaseRules ReleaseRule[]
  watches      Watch[]

  @@unique([name, city])
  @@index([city])
  @@map("restaurants")
}

/// When a restaurant releases new tables, e.g. "Resy, 30 days ahead, at 09:00 Europe/London".
model ReleaseRule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  platform      String   @db.VarChar(40)
  daysInAdvance Int      @map("days_in_advance")
  releaseTime   DateTime @map("release_time") @db.Time(0)
  timezone      String
  bookingUrl    String   @map("booking_url")
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dropAlerts DropAlert[]

  // At most one rule per platform per restaurant. This is what lets the seed script be
  // re-run safely: it can update the rule in place instead of guessing whether the one it
  // finds is the same one it wrote last time. It also replaces the plain index on
  // restaurantId, whose queries this unique index already serves as its leading column.
  @@unique([restaurantId, platform])
  @@map("release_rules")
}

/// A user asking to be told when a specific table becomes bookable.
model Watch {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  targetDate   DateTime    @map("target_date") @db.Date
  partySize    Int         @map("party_size")
  meal         Meal
  status       WatchStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dropAlerts DropAlert[]

  @@unique([userId, restaurantId, targetDate, partySize, meal])
  @@index([userId, status])
  @@index([restaurantId, targetDate])
  @@map("watches")
}

/// A scheduled moment when the watched table is expected to be released.
model DropAlert {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  watchId       String          @map("watch_id") @db.Uuid
  releaseRuleId String          @map("release_rule_id") @db.Uuid
  platform      String          @db.VarChar(40)
  dropDatetime  DateTime        @map("drop_datetime") @db.Timestamptz(6)
  alertAt       DateTime        @map("alert_at") @db.Timestamptz(6)
  bookingUrl    String          @map("booking_url")
  status        DropAlertStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  watch         Watch          @relation(fields: [watchId], references: [id], onDelete: Cascade)
  releaseRule   ReleaseRule    @relation(fields: [releaseRuleId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([watchId])
  @@index([status, alertAt])
  @@map("drop_alerts")
}

/// One delivery attempt of a drop alert to a user.
model Notification {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dropAlertId String              @map("drop_alert_id") @db.Uuid
  channel     NotificationChannel
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz(6)
  status      NotificationStatus  @default(PENDING)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  dropAlert DropAlert @relation(fields: [dropAlertId], references: [id], onDelete: Cascade)

  @@index([dropAlertId])
  @@index([status, createdAt])
  @@map("notifications")
}
