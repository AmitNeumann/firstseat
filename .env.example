# Copy this file to .env.local and paste the real values from your Supabase dashboard.
# .env.local is git-ignored. Never commit real credentials.

# --- Postgres (used by Prisma) ---
# Supabase dashboard -> Connect -> ORMs -> Prisma
# Pooled connection (Transaction pooler, port 6543). Used by the app at runtime;
# serverless functions open many short-lived connections, which the pooler absorbs.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Non-pooled connection (port 5432). Used only by the Prisma CLI to run migrations,
# which issue DDL statements that are unreliable through the transaction pooler.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# --- Supabase API (used by @supabase/supabase-js for Auth) ---
# Supabase dashboard -> Project Settings -> API
# NEXT_PUBLIC_ vars are exposed to the browser by Next.js. The anon/publishable key is
# designed for that and is safe to expose; it grants no access beyond Row Level Security.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="PASTE_ANON_OR_PUBLISHABLE_KEY"

# Never add the service_role / secret key to a NEXT_PUBLIC_ variable: it bypasses
# Row Level Security. We do not need it yet.

# --- Gemini (used by the create-watch "Describe it" parse endpoint) ---
# Server-only. Never prefix this with NEXT_PUBLIC_ — that would ship the key to the browser.
# Google AI Studio → API keys. The parse route reads process.env.GEMINI_API_KEY.
GEMINI_API_KEY="PASTE_GEMINI_API_KEY"

# --- Resend (used to send drop-alert emails) ---
# Server-only. Never prefix this with NEXT_PUBLIC_ — that would ship the key to the browser.
# Resend dashboard → API Keys. The mailer reads process.env.RESEND_API_KEY.
RESEND_API_KEY="PASTE_RESEND_API_KEY"

# --- Cron (used by POST/GET /api/cron/alerts) ---
# Server-only. Vercel Cron sends this as Authorization: Bearer … . Generate a long random
# string. Required in production or the cron route refuses to send. Optional locally if
# you only use `npm run alerts:send-test`.
# CRON_SECRET="PASTE_CRON_SECRET"

# --- Optional ---
# Base URL used to build the confirmation links in Supabase auth emails. Normally left
# unset: the signup Server Action reads the request's Origin header, which is already
# correct for localhost, preview deployments and production alike. Set it only if you hit
# a context that has no Origin header.
# NEXT_PUBLIC_SITE_URL="https://firstseat-lemon.vercel.app"
